# ---- Ollama (runs on the HOST, not in a container) --------------------------
# Docker on macOS has no GPU passthrough. Ollama stays on the host so it uses
# Metal. Containers reach it through host.docker.internal.
# For the fully-contained demo: docker compose --profile bundled-ollama up
OLLAMA_BASE_URL=http://host.docker.internal:11434

LLM_MODEL=qwen3.5:9b
EMBED_MODEL=bge-m3
EMBED_DIMS=1024

# ---- Retrieval: reranking -----------------------------------------------------
# Hybrid search fetches RERANK_CANDIDATES fused rows and a Qwen3-Reranker on the
# host Ollama reorders them (pulled by `make warmup`). If the model is missing,
# errors or misses the RERANK_TIMEOUT_S deadline, search keeps the RRF order.
# RERANK_WORKERS parallel calls only help if the host Ollama runs with
# OLLAMA_NUM_PARALLEL >= RERANK_WORKERS (e.g. `OLLAMA_NUM_PARALLEL=4 ollama serve`).
RERANK_ENABLED=1
RERANK_MODEL=dengcao/Qwen3-Reranker-0.6B
RERANK_CANDIDATES=20
RERANK_WORKERS=4
RERANK_TIMEOUT_S=8
RERANK_CALL_TIMEOUT_S=5

# ---- Retrieval: background chunk context (stage 2) ----------------------------
# After a document is indexed (and already searchable), a background task on the
# llm_bg queue writes a short section summary + keywords per window of chunks
# and re-embeds them in place. Cached by content: re-indexing is free.
# Falls back to LLM_MODEL if CHUNK_CONTEXT_MODEL is not pulled.
# Bump CHUNK_CONTEXT_PROMPT_VERSION to regenerate every summary.
CHUNK_CONTEXT_ENABLED=1
CHUNK_CONTEXT_MODEL=qwen3.5:4b
CHUNK_CONTEXT_WINDOW_TOKENS=3000
CHUNK_CONTEXT_WINDOW_CHUNKS=6
CHUNK_CONTEXT_PROMPT_VERSION=v1
# LLM calls per stage-2 task before it re-queues itself, so the single LLM
# worker is handed back to new uploads every few windows.
CHUNK_CONTEXT_WINDOWS_PER_TASK=4

# "Which documents are about X": minimum cosine similarity for a document to be
# listed by meaning (exact title/keyword matches are always listed first).
DOC_SEARCH_MIN_SIMILARITY=0.45

# ---- Database ---------------------------------------------------------------
POSTGRES_DB=ocrrag
POSTGRES_USER=ocrrag
POSTGRES_PASSWORD=ocrrag
# Host port 5433 avoids clashing with a Postgres already running on the host.
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://ocrrag:ocrrag@db:5432/ocrrag

# ---- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---- Django -----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-not-secret-change-for-any-real-deployment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
MEDIA_ROOT=/data/media

# ---- Auth / sessions --------------------------------------------------------
# Login uses Django's session cookie. `make migrate` / `make up` seeds this
# default staff login on a fresh database (an existing account is never reset):
DEFAULT_USERNAME=NCST_system
DEFAULT_PASSWORD=NCST@12345
# Further accounts are created by an operator:
#     make createuser U=alice
# The frontend origin(s) allowed to send that cookie (comma-separated). The
# frontend and API must share a site (same registrable domain) for the
# SameSite=Lax cookie to be sent, e.g. localhost:3000 + localhost:8000.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Turn both on when serving over HTTPS.
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
# Failed-login throttle, per client IP + username, and per account from any IP.
LOGIN_THROTTLE_RATE=5/min
LOGIN_ACCOUNT_THROTTLE_RATE=30/hour
# Reverse proxies in front of Django that append to X-Forwarded-For. 0 (no
# proxy) ignores the header, so clients cannot choose their throttle identity.
NUM_PROXIES=0

# ---- Frontend ---------------------------------------------------------------
# The browser talks to Django DIRECTLY, not through Next. This is what keeps
# the SSE streams unbuffered.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ---- General chat code runner -----------------------------------------------
# Sandboxed sidecar that runs the Python General chat writes (maths, charts,
# Excel / Word / PowerPoint files). No internet: it sits on an internal network.
CODE_RUNNER_URL=http://code-runner:8090
CODE_RUN_TIMEOUT_S=30

# ---- OCR sidecars -----------------------------------------------------------
EASYOCR_URL=http://ocr-easyocr:8081
PADDLE_URL=http://ocr-paddle:8082

# ---- Chandra OCR 2 (optional) -----------------------------------------------
# Two engines, pick either or both.
#
# `chandra_ollama` — RECOMMENDED, and needs nothing configured here:
#     ollama pull fredrezones55/chandra-ocr-2
#   Faster than the CLI and returns layout boxes. Use that exact build; another
#   upload of this model on Ollama is unpatched and has no vision capability.
DEFAULT_OCR_ENGINE=chandra_ollama
#
# `chandra` — the official CLI, for the exact upstream pipeline. Install with
#   `pip install 'chandra-ocr[hf]'` inside the worker image. It stays greyed out
#   in Settings until the binary is on PATH, and says so as its reason.
#     hf   — local transformers. Self-contained, slower, needs the weights.
#     vllm — talks to a `chandra_vllm` server you start yourself. Much faster.
CHANDRA_BIN=chandra
CHANDRA_METHOD=hf
# Per-run, not per-page: the first run also downloads the weights.
CHANDRA_TIMEOUT_S=1800

# ---- Tuning -----------------------------------------------------------------
# Set to 1 to serialize the OCR fan-out if you hit memory pressure.
OCR_PARALLELISM=2
OCR_DEFAULT_TIMEOUT_S=300
# Upload limits: every page is rasterized, so bytes alone do not bound the work.
MAX_UPLOAD_MB=50
MAX_UPLOAD_PAGES=300
MAX_PAGE_PIXELS=50000000
# Soft limit per OCR engine run, and when a batch with no result is closed.
OCR_TASK_SOFT_TIME_LIMIT_S=3600
OCR_BATCH_STALE_S=21600
