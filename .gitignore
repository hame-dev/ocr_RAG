# ---- Secrets ----------------------------------------------------------------
# .env holds DJANGO_SECRET_KEY and POSTGRES_PASSWORD. Never commit it;
# .env.example is the tracked template.
.env
.env.*
!.env.example

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtualenvs
.venv/
venv/
env/
ENV/

# ---- Django -----------------------------------------------------------------
*.log
db.sqlite3
db.sqlite3-journal
/staticfiles/
/media/

# Celery beat's scheduler state — a binary shelve file rewritten on every tick,
# so it conflicts on every merge and belongs to the runtime, not the repo.
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid

# ---- Tests / tooling --------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- Node / Next.js ---------------------------------------------------------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

# next-env.d.ts is intentionally NOT ignored: Next regenerates it, but it is
# already tracked and TypeScript wants it present on a fresh clone.

# npm/yarn/pnpm debug output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Generated test fixtures ------------------------------------------------
# Rebuilt by `python tests/fixtures/make_test_pdf.py`. They are binary PDFs
# whose bytes change on every regeneration, so tracking them makes noisy diffs.
backend/tests/fixtures/*.pdf

# ---- Docs -------------------------------------------------------------------
docs/

# ---- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
